{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Liteyuki",
  "version": "0.1.0",
  "identifier": "org.liteyuki.rsliteyukibot.tauri",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Liteyuki",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "resources": {
      "../frontend/dist": "frontend/dist"
    },
    "icon": [
      "../assets/app-shell/bot.png",
      "../assets/app-shell/bot.ico"
    ]
  }
}
